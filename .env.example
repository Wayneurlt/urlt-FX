# Copy to .env and fill in. Placeholders only - never commit real values.

# development | test | paper | production
FX_APP_ENV=development

# Local default is SQLite (data/fx.db). Docker Compose uses PostgreSQL:
# FX_DATABASE_URL=postgresql+psycopg://fx:CHANGE_ME@localhost:5432/fx
FX_DATABASE_URL=

# Fernet key used to encrypt integration credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, credentials cannot be stored (integrations stay unconfigured).
FX_SECRET_ENCRYPTION_KEY=

# Cookies: must be true in production (HTTPS)
FX_COOKIE_SECURE=false
FX_SESSION_TTL_MINUTES=480
FX_CORS_ORIGINS=http://localhost:3000

# Optional one-time bootstrap admin (only used when no user exists). Prefer scripts/create_admin.py.
FX_BOOTSTRAP_ADMIN_USERNAME=
FX_BOOTSTRAP_ADMIN_PASSWORD=

# Market data for simulation/paper: deterministic SYNTHETIC generator
FX_MARKET_DATA_PROVIDER=synthetic
FX_SYNTHETIC_SEED=7

FX_WORKER_TICK_SECONDS=2
FX_LOG_LEVEL=INFO

# Web app (server-side only; never NEXT_PUBLIC_)
API_ORIGIN=http://localhost:8000

# Docker Compose PostgreSQL password
POSTGRES_PASSWORD=CHANGE_ME
